# Copy this file to .env.local for local testing.
# On Vercel, add each of these under Settings > Environment Variables.

# Discord bot (Developer Portal > your app > Bot > Reset Token)
DISCORD_BOT_TOKEN=

# Right-click the server icon / channel in Discord (Developer Mode on) > Copy ID
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=

# Discord OAuth2 (Developer Portal > your app > OAuth2)
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# Any long random string. Generate one with: openssl rand -base64 32
AUTH_SECRET=

# Optional
PUBLISHER_ROLE_NAME=Resonants
SITE_NAME=News
